# Template for camunda/oidc/camunda-oidc.env, the settings for docker-compose.camunda-oidc.yml.
#
# `make oidc-env` copies this to camunda-oidc.env (gitignored) and fills every empty value
# with a random secret. Never commit the filled file; on EC2 the same variables come from
# SSM and Secrets Manager.
#
# Versions are camunda-distributions' camunda-8.10 pins, except CAMUNDA_VERSION: upstream
# ships 8.10.10 and we hold at 8.10.9 to match camunda-client-java in pom.xml.

CAMUNDA_VERSION=8.10.9
CAMUNDA_IDENTITY_VERSION=8.10.5
ELASTIC_VERSION=8.19.25
KEYCLOAK_SERVER_VERSION=quay-26.6.4
POSTGRES_VERSION=15-alpine3.24

# Front channel: the browser-facing host it is redirected to and comes back on.
HOST=localhost

# Back channel: the service name for the token and JWKS calls Camunda makes itself.
KEYCLOAK_HOST=keycloak

# Keycloak's own store, not the app's ledger database (T4, on 5433, with its own volume).
POSTGRES_DB=keycloak
POSTGRES_USER=keycloak
POSTGRES_PASSWORD=

KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=

# OIDC clients. Each application gets its own; nothing reuses `orchestration`.
ORCHESTRATION_CLIENT_ID=orchestration
ORCHESTRATION_CLIENT_SECRET=
CAMUNDA_IDENTITY_CLIENT_SECRET=
# The app's job workers (added in T4). Camunda.java reads CAMUNDA_CLIENT_ID/_SECRET/
# _OAUTH_TOKEN_URL/_TOKEN_AUDIENCE, which T4 sets on the worker and api-server services
# themselves: CAMUNDA_CLIENT_* here would also reach orchestration, whose Spring config reads
# those names as camunda.client.*.
ASSETMGMT_APP_CLIENT_SECRET=
# Shinro's analyzer / assessment tool.
SHINRO_ASSESSMENT_CLIENT_SECRET=

# The human account for the Operate UI; on EC2 a generated name with a long password.
# It holds `readonly-admin` in Camunda and "Orchestration Read" in Keycloak, so it reads
# Operate and gets 403 on every write; writes belong to orchestration and assetmgmt-app.
CAMUNDA_DEMO_USERNAME=demo
CAMUNDA_DEMO_PASSWORD=

RESOURCE_AUTHORIZATIONS_ENABLED=true
